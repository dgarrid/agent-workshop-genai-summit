# =============================================================================
# Configuración de Entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores
# NUNCA subas .env a control de versiones
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC API
# -----------------------------------------------------------------------------
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a utilizar (ver modelos disponibles en https://docs.anthropic.com/en/docs/models)
# Opciones recomendadas:
#   - claude-sonnet-4-5-20250929  (mejor relación calidad/precio para agentes)
#   - claude-haiku-4-5-20251001   (más barato, para alto volumen)
#   - claude-opus-4-5-20251101    (máxima capacidad, más caro)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------------
# GOBERNANZA FINANCIERA
# -----------------------------------------------------------------------------
# Presupuesto máximo por sesión en euros (el agente se detiene al alcanzarlo)
BUDGET_LIMIT_EUR=5.00

# Tipo de cambio EUR/USD (actualizar según mercado)
EUR_USD_RATE=1.08

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL AGENTE
# -----------------------------------------------------------------------------
# Número máximo de iteraciones del bucle agente (protección anti-loop)
MAX_ITERATIONS=25

# Timeout por llamada a la API en segundos
API_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# PATHS (normalmente no necesitas cambiar estos)
# -----------------------------------------------------------------------------
# Ruta a la base de datos CRM simulada
CRM_DATABASE_PATH=data/crm.db

# Ruta a la base de conocimiento
KNOWLEDGE_BASE_PATH=data/knowledge

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directorio para logs de auditoría
AUDIT_LOG_PATH=logs/audit